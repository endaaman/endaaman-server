[Unit]
Description=portmap: 外から受けるポートの制限と転送 (nftables / endaaman-server/portmap)
# ネットワークが上がる前に入れる（起動直後に素通しの時間を作らない）
DefaultDependencies=no
Wants=network-pre.target
Before=network-pre.target shutdown.target
Conflicts=shutdown.target
ConditionPathExists=/etc/portmap/portmap.nft

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/sbin/nft -f /etc/portmap/portmap.nft
ExecReload=/usr/sbin/nft -f /etc/portmap/portmap.nft
ExecStop=/usr/sbin/nft delete table inet portmap

[Install]
WantedBy=sysinit.target
